{
  "name": "ghostrecon",
  "version": "1.0.0",
  "description": "Framework passivo de OSINT / recon para bug bounty",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-stack.mjs",
    "stack:status": "node scripts/stack-control.mjs status",
    "stack:stop": "node scripts/stack-control.mjs stop",
    "start:bash": "bash scripts/start-stack.sh",
    "start:api": "node server/index.js",
    "start:minimal": "GHOSTRECON_STACK_VIGOLIUM=0 GHOSTRECON_STACK_GHOST=0 GHOSTRECON_STACK_GHOSTTRACE=0 GHOSTRECON_STACK_GHOSTMAP=0 GHOSTRECON_STACK_GHOSTDESK=0 GHOSTRECON_STACK_HEXSTRIKE=0 node server/index.js",
    "start:anotacao": "bash scripts/start-anotacao.sh",
    "start:ghostmap": "bash scripts/start-ghostmap.sh",
    "start:ghostdesk": "bash scripts/start-ghostdesk.sh",
    "start:stack+anotacao": "npm start",
    "start:ghost": "bash ghost-local-v5/ghost-local/start.sh",
    "dev": "node --watch server/index.js",
    "test": "node scripts/run-server-tests.mjs",
    "test:network": "node scripts/run-server-tests.mjs --network",
    "test:all": "node scripts/run-server-tests.mjs --include-network",
    "test:auto:hermetic": "node scripts/run-auto-gate.mjs --hermetic-only",
    "test:auto:gate": "node scripts/run-auto-gate.mjs",
    "test:mcp": "node --test server/tests/ghostrecon-mcp.test.js",
    "test:cli": "node --test server/tests/cli-*.test.js",
    "mitre:extract": "node server/scripts/extract-mitre-recon-bundle.mjs",
    "pentestgpt-bridge": "node server/scripts/pentestgpt-ghost-bridge.mjs",
    "test:ai": "node server/scripts/test-ai-apis-smoke.js",
    "cli": "node bin/ghostrecon.mjs",
    "db:vps:sync": "node server/scripts/sync-sqlite-to-postgres.mjs",
    "db:link": "supabase link --project-ref lchttisqazjuapczstkm",
    "db:push": "supabase db push",
    "db:migration:new": "supabase migration new",
    "engine:install": "bash scripts/install-vigolium-engine.sh",
    "engine:build": "bash scripts/build-vigolium-engine.sh"
  },
  "bin": {
    "ghostrecon": "./bin/ghostrecon.mjs"
  },
  "engines": {
    "node": ">=20 <27"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "playwright": "^1.61.1",
    "postgres": "^3.4.8",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "supabase": "^2.84.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "ws": "8.21.0"
  }
}
