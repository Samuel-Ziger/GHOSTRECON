{
  "mcpServers": {
    "ghostrecon": {
      "command": "node",
      "args": [
        "mcp/ghostrecon-mcp.mjs"
      ],
      "env": {
        "GHOSTRECON_URL": "http://127.0.0.1:3847",
        "GHOSTRECON_MCP_AUTOSTART": "1",
        "GHOSTRECON_MCP_MAX_TEXT_CHARS": "120000"
      },
      "description": "GHOSTRECON local MCP: recon, Auto Mode, runs, intel, capabilities and OPSEC-aware orchestration",
      "timeout": 600,
      "disabled": false
    },
    "hexstrike-ai": {
      "command": "node",
      "args": [
        "mcp/hexstrike-mcp-launcher.mjs"
      ],
      "env": {
        "GHOSTRECON_HEXSTRIKE_URL": "http://127.0.0.1:8888",
        "GHOSTRECON_HEXSTRIKE_PORT": "8888",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "HexStrike AI local MCP (autostarts API on :8888). Authorized offensive tooling only.",
      "timeout": 600,
      "disabled": false
    }
  }
}
