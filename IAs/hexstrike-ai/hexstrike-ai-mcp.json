{
  "mcpServers": {
    "hexstrike-ai": {
      "command": "node",
      "args": [
        "mcp/hexstrike-mcp-launcher.mjs"
      ],
      "env": {
        "GHOSTRECON_HEXSTRIKE_URL": "http://127.0.0.1:8888",
        "GHOSTRECON_HEXSTRIKE_PORT": "8888",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "HexStrike AI local MCP via GHOSTRECON launcher. Turn off alwaysAllow if you dont want autonomous execution!",
      "timeout": 600,
      "alwaysAllow": []
    }
  }
}
