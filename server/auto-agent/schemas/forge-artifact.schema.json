{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GHOSTRECON Pending Module Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleCode", "testCode", "manifest", "implementationNotes"],
  "properties": {
    "moduleCode": { "type": "string", "minLength": 20, "maxLength": 200000 },
    "testCode": { "type": "string", "minLength": 20, "maxLength": 200000 },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "intrusive", "requiresAuth", "requiresKali", "timeoutMs", "concurrency", "outputs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "enum": ["discovery", "surface", "validation", "ai", "persistence", "reporting"] },
        "intrusive": { "const": false },
        "requiresAuth": { "type": "boolean" },
        "requiresKali": { "const": false },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "enum": ["finding", "intel", "artifact", "metric"] } }
      }
    },
    "implementationNotes": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 2000 } }
  }
}
